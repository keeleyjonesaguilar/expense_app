<%- include('partials/head', { title: 'Bulk Import' }) %>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link" href="/admin/transactions">All Transactions</a></li>
  <li class="nav-item"><a class="nav-link active" href="/admin/import">Import</a></li>
</ul>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Bulk Import — Spreadsheets, PDFs &amp; Images</h3>
  <a href="/admin/import/template.csv" class="btn btn-outline-secondary btn-sm">Download Import Template</a>
</div>
<div class="card p-4 mb-4">
  <p class="text-muted">Upload a spreadsheet export (CSV/XLSX), or a PDF/image statement or receipt.
  Every row gets a suggested category you can correct before anything is saved.</p>
  <form method="post" action="/admin/import" enctype="multipart/form-data" class="row g-2">
    <div class="col-md-8"><input type="file" name="file" class="form-control" accept=".csv,.xlsx,.xls,.pdf,.png,.jpg,.jpeg" required></div>
    <div class="col-md-4"><button class="btn btn-primary w-100">Upload &amp; Extract</button></div>
  </form>
</div>

<% if (sheets && sheets.length > 1) { %>
<div class="card p-3 mb-4">
  <form method="get" action="/admin/import" class="row g-2 align-items-end">
    <input type="hidden" name="upload_id" value="<%= upload_id %>">
    <div class="col-md-6">
      <label class="form-label mb-1">This workbook has multiple sheets -- pick one to import from</label>
      <select name="sheet" class="form-select">
        <% sheets.forEach(function (s) { %>
          <option value="<%= s.name %>" <%= s.name === current_sheet ? 'selected' : '' %>>
            <%= s.name %> (<%= s.rowCount %> rows<%= s.looksLikeTransactions ? '' : ' -- no date/amount columns found' %>)
          </option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3"><button class="btn btn-outline-primary">Use this sheet</button></div>
  </form>
</div>
<% } %>

<% if (column_mapping && column_mapping.length) { %>
<div class="card p-3 mb-4">
  <h6>Column Mapping</h6>
  <p class="text-muted small mb-2">How each source column was matched. Columns marked "Not imported" are dropped entirely -- their data doesn't end up anywhere on the resulting transactions. Change a mapping and click Re-map to re-preview.</p>
  <form method="get" action="/admin/import">
    <input type="hidden" name="upload_id" value="<%= upload_id %>">
    <% if (current_sheet) { %><input type="hidden" name="sheet" value="<%= current_sheet %>"><% } %>
    <table class="table table-sm mb-2">
      <thead><tr><th>Source Column</th><th>Matched To</th></tr></thead>
      <tbody>
        <% column_mapping.forEach(function (m) { %>
        <tr>
          <td><%= m.column %></td>
          <td>
            <select name="map[<%= m.column %>]" class="form-select form-select-sm" style="width:200px">
              <option value="none" <%= !m.matchedField ? 'selected' : '' %>>Not imported</option>
              <% remappable_fields.forEach(function (f) { %>
                <option value="<%= f %>" <%= m.matchedField === f ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <button class="btn btn-outline-primary btn-sm">Re-map &amp; Preview</button>
  </form>
</div>
<% } %>

<% if (preview_rows) { %>
<form method="post" action="/admin/import/<%= upload_id %>/commit">
  <div class="card p-3">
    <h6>Review before importing (<%= preview_rows.length %> rows)</h6>
    <div style="overflow-x:auto">
    <table class="table table-sm">
      <thead><tr><th>Skip</th><th>Date</th><th>Qty</th><th>Price/Item</th><th>Total Price</th><th>Category</th><th>Vendor</th><th>Employee</th><th>Description</th><th>Link</th><th>Notes</th><th>One-Time</th></tr></thead>
      <tbody>
      <% preview_rows.forEach(function (row, i) { %>
        <tr>
          <td><input type="checkbox" name="skip_<%= i %>"></td>
          <td><input type="date" name="date_<%= i %>" value="<%= row.date || '' %>" class="form-control form-control-sm"></td>
          <td><input type="number" step="any" name="quantity_<%= i %>" value="<%= row.quantity != null ? row.quantity : '' %>" class="form-control form-control-sm" style="width:70px"></td>
          <td><input type="number" step="0.01" name="unit_price_<%= i %>" value="<%= row.unit_price != null ? row.unit_price : '' %>" class="form-control form-control-sm" style="width:90px"></td>
          <td><input type="number" step="0.01" name="amount_<%= i %>" value="<%= row.amount != null ? row.amount : '' %>" class="form-control form-control-sm" style="width:100px"></td>
          <td>
            <select name="category_<%= i %>" class="form-select form-select-sm">
              <% categories.forEach(function (c) { %><option value="<%= c.name %>" <%= row.suggested_category === c.name ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </td>
          <td><input type="text" name="vendor_<%= i %>" value="<%= row.vendor || '' %>" class="form-control form-control-sm" style="width:120px"></td>
          <td>
            <select name="employee_id_<%= i %>" class="form-select form-select-sm" style="width:130px">
              <option value="">-- none --</option>
              <% employees.forEach(function (e) { %><option value="<%= e.id %>" <%= row.employee_id === e.id ? 'selected' : '' %>><%= e.name %></option><% }) %>
            </select>
          </td>
          <td><input type="text" name="description_<%= i %>" value="<%= row.description || '' %>" class="form-control form-control-sm" style="width:200px"></td>
          <td><input type="url" name="link_<%= i %>" value="<%= row.link || '' %>" class="form-control form-control-sm" style="width:140px"></td>
          <td><input type="text" name="notes_<%= i %>" value="<%= row.notes || '' %>" class="form-control form-control-sm" style="width:180px"></td>
          <td><input type="checkbox" name="one_time_<%= i %>" <%= row.suggest_one_time ? 'checked' : '' %>></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <button class="btn btn-success">Commit Selected Rows</button>
  </div>
</form>
<% } %>

<div class="card p-3 mt-4">
  <h6>Recent Uploads</h6>
  <table class="table table-sm">
    <thead><tr><th>File</th><th>Type</th><th>Uploaded</th><th>Rows Found</th><th>Rows Imported</th></tr></thead>
    <tbody>
    <% recent_uploads.forEach(function (u) { %>
      <tr><td><%= u.filename %></td><td><%= u.file_type %></td><td><%= fmtDateTime(u.uploaded_at) %></td><td><%= u.row_count %></td><td>
        <% if (u.imported_count) { %><a href="/admin/transactions?upload_id=<%= u.id %>"><%= u.imported_count %></a><% } else { %>0<% } %>
      </td></tr>
    <% }) %>
    </tbody>
  </table>
</div>
<%- include('partials/foot') %>
