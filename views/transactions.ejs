<%- include('partials/head', { title: 'Transactions' }) %>
<%- include('partials/transactions_nav', { active: 'all' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>All Transactions</h3>
  <div>
    <a href="/admin/transactions/export.csv" class="btn btn-outline-secondary btn-sm">Download CSV</a>
    <a href="/admin/transactions/new" class="btn btn-primary btn-sm">+ Add Manual Entry</a>
  </div>
</div>

<form method="get" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="category_id" class="form-select form-select-sm">
      <option value="">All categories</option>
      <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= String(filters.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="employee_id" class="form-select form-select-sm">
      <option value="">All employees</option>
      <% employees.forEach(function (e) { %><option value="<%= e.id %>" <%= String(filters.employee_id) === String(e.id) ? 'selected' : '' %>><%= e.name %></option><% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="one_time" class="form-select form-select-sm">
      <option value="">One-time: any</option>
      <option value="1" <%= filters.one_time === '1' ? 'selected' : '' %>>One-time only</option>
      <option value="0" <%= filters.one_time === '0' ? 'selected' : '' %>>Recurring only</option>
    </select>
  </div>
  <div class="col-auto">
    <select name="status" class="form-select form-select-sm">
      <option value="" <%= filters.status === '' ? 'selected' : '' %>>Status: any</option>
      <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
      <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="awaiting_order" <%= filters.status === 'awaiting_order' ? 'selected' : '' %>>Awaiting Order</option>
      <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
    </select>
  </div>
  <div class="col-auto d-flex align-items-center gap-1">
    <select id="date_preset" class="form-select form-select-sm" style="width:auto" aria-label="Date range">
      <option value="">Any date</option>
      <option value="this_month">This month</option>
      <option value="last_month">Last month</option>
      <option value="this_quarter">This quarter</option>
      <option value="this_year">This year</option>
      <option value="last_year">Last year</option>
      <option value="custom">Custom range</option>
    </select>
    <input type="date" name="date_from" id="date_from" value="<%= filters.date_from %>" class="form-control form-control-sm" aria-label="From date" title="From">
    <span class="small text-muted">to</span>
    <input type="date" name="date_to" id="date_to" value="<%= filters.date_to %>" class="form-control form-control-sm" aria-label="To date" title="To">
  </div>
  <div class="col-auto"><button class="btn btn-outline-secondary btn-sm">Filter</button></div>
  <% if (filters.date_from || filters.date_to || filters.category_id || filters.employee_id || filters.one_time) { %>
    <div class="col-auto"><a href="/admin/transactions<%= filters.per_page ? '?per_page=' + encodeURIComponent(filters.per_page) : '' %>" class="btn btn-link btn-sm">Clear filters</a></div>
  <% } %>
  <div class="col-auto ms-auto d-flex align-items-center gap-1">
    <label for="per_page" class="small text-muted text-nowrap mb-0">Show</label>
    <select name="per_page" id="per_page" class="form-select form-select-sm" onchange="this.form.submit()">
      <% paging.pageSizes.forEach(function (n) { %><option value="<%= n %>" <%= paging.perPage === n ? 'selected' : '' %>><%= n %></option><% }) %>
    </select>
    <span class="small text-muted text-nowrap">per page</span>
  </div>
</form>
<p class="text-muted small">Showing <strong>Approved</strong> transactions by default — filter to Status: Pending to review expense reports awaiting approval. Supply requests live on the <a href="/admin/transactions/requests">Item Requests</a> tab instead.</p>

<div class="card">
<table class="table table-sm mb-0">
  <thead class="table-light">
    <tr>
      <th>Date</th><th>Category</th><th>Tags</th><th>Vendor</th><th>Employee</th><th>Description</th>
      <th class="text-end">Qty</th><th class="text-end">Price/Item</th><th class="text-end">Total</th>
      <th>Link</th><th>One-Time</th><th>Status</th><th>Notes</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% if (txs.length === 0) { %>
    <tr><td colspan="14" class="text-center text-muted py-4">No transactions match those filters.</td></tr>
    <% } %>
    <% txs.forEach(function (t) { %>
    <tr>
      <td><%= fmtDate(t.date) %></td>
      <td>
        <%= t.category ? t.category.name : 'Uncategorized' %>
        <% if (t.review_reason) { %><a href="/admin/review" class="badge bg-warning text-dark text-decoration-none" title="<%= t.review_reason %>">Needs review</a><% } %>
      </td>
      <td><% (t.tags || []).forEach(function (tn) { %><span class="badge bg-secondary me-1"><%= tn %></span><% }) %></td>
      <td><%= t.vendor ? t.vendor.name : '' %></td>
      <td><%= t.employee ? t.employee.name : (t.submitted_by ? t.submitted_by.name : '-') %></td>
      <td><%= t.description %></td>
      <td class="text-end"><%= t.quantity != null ? t.quantity : '' %></td>
      <td class="text-end"><%= t.unit_price != null ? ('$' + fmt2(t.unit_price)) : '' %></td>
      <td class="text-end">$<%= fmt2(t.amount) %></td>
      <td><% if (t.link) { %><a href="<%= t.link %>" target="_blank" rel="noopener">link</a><% } %></td>
      <td><%= t.is_one_time ? 'Yes' : 'No' %></td>
      <td>
        <% if (t.status === 'pending') { %><span class="badge badge-pending">Pending</span>
        <% } else if (t.status === 'approved') { %><span class="badge badge-approved">Approved</span>
        <% } else if (t.status === 'awaiting_order') { %><span class="badge bg-info text-dark">Awaiting Order</span>
        <% } else { %><span class="badge badge-rejected">Rejected</span><% } %>
      </td>
      <td><%= t.notes || '' %></td>
      <td class="text-nowrap">
        <% if (t.status === 'pending' && t.source !== 'supply_request') { %>
          <form method="post" action="/admin/approvals/<%= t.id %>/approve" class="d-inline">
            <input type="hidden" name="next" value="/admin/transactions?status=pending">
            <button class="btn btn-success btn-sm">Approve</button>
          </form>
          <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="collapse" data-bs-target="#reject-<%= t.id %>">Reject</button>
        <% } else { %>
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-<%= t.id %>">Edit</button>
        <% } %>
      </td>
    </tr>
    <% if (t.status === 'pending' && t.source !== 'supply_request') { %>
    <tr class="collapse" id="reject-<%= t.id %>">
      <td colspan="14" class="bg-light">
        <form method="post" action="/admin/approvals/<%= t.id %>/reject" class="row g-2 align-items-end py-2">
          <input type="hidden" name="next" value="/admin/transactions?status=pending">
          <div class="col-md-8">
            <label class="form-label small mb-0">Reason for rejection</label>
            <textarea name="reason" class="form-control form-control-sm" rows="1" required></textarea>
          </div>
          <div class="col-md-2"><button class="btn btn-danger btn-sm w-100">Confirm Reject</button></div>
        </form>
      </td>
    </tr>
    <% } %>
    <tr class="collapse" id="edit-<%= t.id %>">
      <td colspan="14" class="bg-light">
        <form method="post" action="/admin/transactions/<%= t.id %>/update" class="row g-2 align-items-end py-2" data-tag-scope>
          <input type="hidden" name="next" value="<%= currentUrl %>">
          <input type="hidden" name="tags_present" value="1">
          <div class="col-auto">
            <label class="form-label small mb-0">Category</label>
            <select name="category_id" class="form-select form-select-sm" data-tag-category-select>
              <% if (!t.category_id) { %><option value="" selected>Choose...</option><% } %>
              <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= t.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="col-12">
            <label class="form-label small mb-0 d-block">Tags</label>
            <% tags.forEach(function (tg) { %>
              <div class="form-check form-check-inline" data-tag-category="<%= tg.category_id %>">
                <input type="checkbox" class="form-check-input" name="tag" value="<%= tg.name %>" id="txtag-<%= t.id %>-<%= tg.id %>"
                  <%= (t.tags || []).includes(tg.name) ? 'checked' : '' %>>
                <label class="form-check-label small" for="txtag-<%= t.id %>-<%= tg.id %>"><%= tg.name %></label>
              </div>
            <% }) %>
            <span class="small text-muted d-none" data-tag-empty></span>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Vendor</label>
            <input type="text" name="vendor_name" value="<%= t.vendor ? t.vendor.name : '' %>" class="form-control form-control-sm" style="width:130px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Description</label>
            <input type="text" name="description" value="<%= t.description || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Qty</label>
            <input type="number" step="any" name="quantity" value="<%= t.quantity != null ? t.quantity : '' %>" class="form-control form-control-sm" style="width:80px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Price/Item</label>
            <input type="number" step="0.01" name="unit_price" value="<%= t.unit_price != null ? t.unit_price : '' %>" class="form-control form-control-sm" style="width:100px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Total</label>
            <input type="number" step="0.01" name="amount" value="<%= t.amount %>" class="form-control form-control-sm" style="width:100px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Link</label>
            <input type="url" name="link" value="<%= t.link || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Notes</label>
            <input type="text" name="notes" value="<%= t.notes || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto form-check">
            <input type="checkbox" class="form-check-input" name="is_one_time" id="onetime-<%= t.id %>" <%= t.is_one_time ? 'checked' : '' %>>
            <label class="form-check-label small" for="onetime-<%= t.id %>">One-Time</label>
          </div>
          <div class="col-auto"><button class="btn btn-primary btn-sm">Save</button></div>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>

<%
  // Page links: first, last, and a window of 2 either side of the current
  // page, with a gap marker (null) wherever pages are skipped.
  const pageLinks = [];
  for (let n = 1; n <= paging.pageCount; n++) {
    if (n === 1 || n === paging.pageCount || Math.abs(n - paging.page) <= 2) pageLinks.push(n);
    else if (pageLinks[pageLinks.length - 1] !== null) pageLinks.push(null);
  }
  const firstShown = paging.totalCount ? (paging.page - 1) * paging.perPage + 1 : 0;
  const lastShown = Math.min(paging.page * paging.perPage, paging.totalCount);
%>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
  <div class="small text-muted">Showing <%= firstShown %>–<%= lastShown %> of <%= paging.totalCount %></div>
  <% if (paging.pageCount > 1) { %>
  <nav aria-label="Transactions pages">
    <ul class="pagination pagination-sm mb-0">
      <li class="page-item <%= paging.page === 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= paging.pageUrl(paging.page - 1) %>">Previous</a></li>
      <% pageLinks.forEach(function (n) { %>
        <% if (n === null) { %>
          <li class="page-item disabled"><span class="page-link">…</span></li>
        <% } else { %>
          <li class="page-item <%= n === paging.page ? 'active' : '' %>"><a class="page-link" href="<%= paging.pageUrl(n) %>"><%= n %></a></li>
        <% } %>
      <% }) %>
      <li class="page-item <%= paging.page === paging.pageCount ? 'disabled' : '' %>"><a class="page-link" href="<%= paging.pageUrl(paging.page + 1) %>">Next</a></li>
    </ul>
  </nav>
  <% } %>
</div>
<%
const extraScripts = `
<script>
// Date-range quick picks: fill the From/To inputs and apply. On load, show
// which preset (if any) the current range matches, else "Custom range".
(function () {
  var preset = document.getElementById('date_preset');
  var from = document.getElementById('date_from');
  var to = document.getElementById('date_to');
  if (!preset || !from || !to) return;
  function iso(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function range(key) {
    var now = new Date(), y = now.getFullYear(), m = now.getMonth();
    if (key === 'this_month') return [new Date(y, m, 1), new Date(y, m + 1, 0)];
    if (key === 'last_month') return [new Date(y, m - 1, 1), new Date(y, m, 0)];
    if (key === 'this_quarter') { var q = Math.floor(m / 3) * 3; return [new Date(y, q, 1), new Date(y, q + 3, 0)]; }
    if (key === 'this_year') return [new Date(y, 0, 1), new Date(y, 11, 31)];
    if (key === 'last_year') return [new Date(y - 1, 0, 1), new Date(y - 1, 11, 31)];
    return null;
  }
  var keys = ['this_month', 'last_month', 'this_quarter', 'this_year', 'last_year'];
  if (from.value || to.value) {
    preset.value = 'custom';
    keys.forEach(function (k) {
      var r = range(k);
      if (from.value === iso(r[0]) && to.value === iso(r[1])) preset.value = k;
    });
  }
  preset.addEventListener('change', function () {
    if (preset.value === 'custom') { from.focus(); return; }
    var r = range(preset.value);
    from.value = r ? iso(r[0]) : '';
    to.value = r ? iso(r[1]) : '';
    preset.form.submit();
  });
  // Typing a date by hand switches the picker to "Custom range".
  [from, to].forEach(function (el) {
    el.addEventListener('change', function () { preset.value = from.value || to.value ? 'custom' : ''; });
  });
})();
</script>
`;
%>
<%- include('partials/foot', { extraScripts }) %>
