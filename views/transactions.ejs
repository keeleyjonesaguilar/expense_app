<%- include('partials/head', { title: 'Transactions' }) %>
<ul class="nav nav-tabs mb-3">
  <li class="nav-item"><a class="nav-link active" href="/admin/transactions">All Transactions</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/import">Import</a></li>
</ul>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3>All Transactions</h3>
  <div>
    <a href="/admin/transactions/export.csv" class="btn btn-outline-secondary btn-sm">Download CSV</a>
    <a href="/admin/transactions/new" class="btn btn-primary btn-sm">+ Add Manual Entry</a>
  </div>
</div>

<form method="get" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="category_id" class="form-select form-select-sm">
      <option value="">All categories</option>
      <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= String(filters.category_id) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="employee_id" class="form-select form-select-sm">
      <option value="">All employees</option>
      <% employees.forEach(function (e) { %><option value="<%= e.id %>" <%= String(filters.employee_id) === String(e.id) ? 'selected' : '' %>><%= e.name %></option><% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="one_time" class="form-select form-select-sm">
      <option value="">One-time: any</option>
      <option value="1" <%= filters.one_time === '1' ? 'selected' : '' %>>One-time only</option>
      <option value="0" <%= filters.one_time === '0' ? 'selected' : '' %>>Recurring only</option>
    </select>
  </div>
  <div class="col-auto">
    <select name="status" class="form-select form-select-sm">
      <option value="" <%= filters.status === '' ? 'selected' : '' %>>Status: any</option>
      <option value="approved" <%= filters.status === 'approved' ? 'selected' : '' %>>Approved</option>
      <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
      <option value="awaiting_order" <%= filters.status === 'awaiting_order' ? 'selected' : '' %>>Awaiting Order</option>
      <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
    </select>
  </div>
  <div class="col-auto"><button class="btn btn-outline-secondary btn-sm">Filter</button></div>
</form>
<p class="text-muted small">Showing <strong>Approved</strong> transactions by default — pending and awaiting-order items live on the <a href="/admin/approvals">Approvals</a> page until they're confirmed.</p>

<div class="card">
<table class="table table-sm mb-0">
  <thead class="table-light">
    <tr>
      <th>Date</th><th>Category</th><th>Vendor</th><th>Employee</th><th>Description</th>
      <th class="text-end">Qty</th><th class="text-end">Price/Item</th><th class="text-end">Total</th>
      <th>Link</th><th>One-Time</th><th>Status</th><th>Notes</th><th></th>
    </tr>
  </thead>
  <tbody>
    <% if (txs.length === 0) { %>
    <tr><td colspan="13" class="text-center text-muted py-4">No transactions match those filters.</td></tr>
    <% } %>
    <% txs.forEach(function (t) { %>
    <tr>
      <td><%= fmtDate(t.date) %></td>
      <td><%= t.category ? t.category.name : 'Uncategorized' %></td>
      <td><%= t.vendor ? t.vendor.name : '' %></td>
      <td><%= t.employee ? t.employee.name : (t.submitted_by ? t.submitted_by.name : '-') %></td>
      <td><%= t.description %></td>
      <td class="text-end"><%= t.quantity != null ? t.quantity : '' %></td>
      <td class="text-end"><%= t.unit_price != null ? ('$' + fmt2(t.unit_price)) : '' %></td>
      <td class="text-end">$<%= fmt2(t.amount) %></td>
      <td><% if (t.link) { %><a href="<%= t.link %>" target="_blank" rel="noopener">link</a><% } %></td>
      <td><%= t.is_one_time ? 'Yes' : 'No' %></td>
      <td>
        <% if (t.status === 'pending') { %><span class="badge badge-pending">Pending</span>
        <% } else if (t.status === 'approved') { %><span class="badge badge-approved">Approved</span>
        <% } else if (t.status === 'awaiting_order') { %><span class="badge bg-info text-dark">Awaiting Order</span>
        <% } else { %><span class="badge badge-rejected">Rejected</span><% } %>
      </td>
      <td><%= t.notes || '' %></td>
      <td><button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#edit-<%= t.id %>">Edit</button></td>
    </tr>
    <tr class="collapse" id="edit-<%= t.id %>">
      <td colspan="13" class="bg-light">
        <form method="post" action="/admin/transactions/<%= t.id %>/update" class="row g-2 align-items-end py-2">
          <div class="col-auto">
            <label class="form-label small mb-0">Category</label>
            <select name="category_id" class="form-select form-select-sm">
              <% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= t.category_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
            </select>
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Vendor</label>
            <input type="text" name="vendor_name" value="<%= t.vendor ? t.vendor.name : '' %>" class="form-control form-control-sm" style="width:130px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Description</label>
            <input type="text" name="description" value="<%= t.description || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Qty</label>
            <input type="number" step="any" name="quantity" value="<%= t.quantity != null ? t.quantity : '' %>" class="form-control form-control-sm" style="width:80px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Price/Item</label>
            <input type="number" step="0.01" name="unit_price" value="<%= t.unit_price != null ? t.unit_price : '' %>" class="form-control form-control-sm" style="width:100px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Total</label>
            <input type="number" step="0.01" name="amount" value="<%= t.amount %>" class="form-control form-control-sm" style="width:100px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Link</label>
            <input type="url" name="link" value="<%= t.link || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto">
            <label class="form-label small mb-0">Notes</label>
            <input type="text" name="notes" value="<%= t.notes || '' %>" class="form-control form-control-sm" style="width:180px">
          </div>
          <div class="col-auto form-check">
            <input type="checkbox" class="form-check-input" name="is_one_time" id="onetime-<%= t.id %>" <%= t.is_one_time ? 'checked' : '' %>>
            <label class="form-check-label small" for="onetime-<%= t.id %>">One-Time</label>
          </div>
          <div class="col-auto"><button class="btn btn-primary btn-sm">Save</button></div>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('partials/foot') %>
