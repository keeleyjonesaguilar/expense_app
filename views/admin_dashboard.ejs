<%
const hasCategories = top_categories && top_categories.length > 0;
const hasMonths = months_sorted && months_sorted.length > 0;
const hasSplit = (recurring_total + onetime_total + event_marketing_total) > 0;

const extraScripts = `
<script src="/static/vendor/chart.umd.min.js"></script>
<script>
const PALETTE = ['#2a78d6','#eb6834','#1baf7a','#eda100','#e87ba4','#008300','#4a3aa7','#e34948'];
const SPLIT_COLORS = { recurring: '#2a78d6', onetime: '#eb6834', eventMarketing: '#1baf7a' };

${hasCategories ? `
new Chart(document.getElementById('catChart'), {
  type: 'bar',
  data: {
    labels: ${JSON.stringify(top_categories.map((c) => c[0]))},
    datasets: [{
      data: ${JSON.stringify(top_categories.map((c) => c[1]))},
      backgroundColor: PALETTE[0],
      borderRadius: 4,
    }]
  },
  options: {
    indexAxis: 'y',
    plugins: { legend: { display: false } },
    scales: { x: { ticks: { callback: v => '$' + v.toLocaleString() } } }
  }
});` : ''}

${hasMonths ? `
new Chart(document.getElementById('monthChart'), {
  type: 'line',
  data: {
    labels: ${JSON.stringify(months_sorted.map((m) => m[0]))},
    datasets: [{
      label: 'Monthly Spend',
      data: ${JSON.stringify(months_sorted.map((m) => m[1]))},
      borderColor: PALETTE[0], backgroundColor: PALETTE[0] + '33',
      fill: true, tension: 0.25, pointRadius: 3,
    }]
  },
  options: {
    plugins: { legend: { display: false } },
    scales: { y: { ticks: { callback: v => '$' + v.toLocaleString() } } }
  }
});` : ''}

${hasSplit ? `
new Chart(document.getElementById('splitChart'), {
  type: 'doughnut',
  data: {
    labels: ['Recurring', 'One-Time', 'Event/Marketing'],
    datasets: [{
      data: [${recurring_total}, ${onetime_total}, ${event_marketing_total}],
      backgroundColor: [SPLIT_COLORS.recurring, SPLIT_COLORS.onetime, SPLIT_COLORS.eventMarketing],
    }]
  },
  options: { plugins: { legend: { position: 'right' } } }
});` : ''}
</script>
`;
%>
<%- include('partials/head', { title: 'Dashboard' }) %>
<style>
  .dashboard-title { font-size: 1.75rem; font-weight: 700; }
  .stat-tile { min-height: 108px; display: flex; flex-direction: column; justify-content: center; }
  .stat-tile.accent-recurring { border-top: 3px solid #2a78d6; }
  .stat-tile.accent-onetime { border-top: 3px solid #eb6834; }
  .stat-tile.accent-event { border-top: 3px solid #1baf7a; }
  .chart-row { margin-top: 1.5rem; }
  .empty-chart-state { display: flex; align-items: center; justify-content: center; height: 220px; color: #6b6a63; font-size: .9rem; }
</style>

<% if (pending_expense_reports_count > 0 || open_requests_count > 0) { %>
<div class="card p-3 mb-4" style="border-left: 4px solid var(--brand-gold);">
  <h6 class="mb-2">Needs Your Review</h6>
  <div class="row g-3">
    <% if (pending_expense_reports_count > 0) { %>
    <div class="col-md-4">
      <a href="/admin/transactions?status=pending" class="text-decoration-none">
        <div class="stat-tile" style="min-height:auto;">
          <div class="label">Expense Reports Pending</div>
          <div class="value"><%= pending_expense_reports_count %></div>
        </div>
      </a>
    </div>
    <% } %>
    <% if (open_requests.length) { %>
    <div class="col-md-8">
      <div class="small text-muted text-uppercase mb-1" style="letter-spacing:.03em;">
        Open Item / Event Requests (<%= open_requests_count %>)
      </div>
      <table class="table table-sm mb-1">
        <tbody>
          <% open_requests.forEach(function (t) { %>
          <tr style="cursor:pointer" onclick="window.location='/admin/transactions/requests/<%= t.id %>'">
            <td><%= t.description %></td>
            <td class="text-muted small"><%= t.category ? t.category.name : 'Uncategorized' %></td>
            <td>
              <% (t.tags || []).slice(0, 2).forEach(function (name) { %><span class="badge text-bg-light border me-1"><%= name %></span><% }) %>
            </td>
            <td class="text-end">
              <% if (t.status === 'awaiting_order') { %><span class="badge bg-info text-dark">Awaiting Order</span>
              <% } else { %><span class="badge badge-pending">Pending</span><% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <a href="/admin/transactions/requests" class="small">View all requests &rarr;</a>
    </div>
    <% } %>
  </div>
</div>
<% } %>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <h3 class="dashboard-title mb-0">Admin Dashboard</h3>
  <form method="get" class="d-flex align-items-center gap-2">
    <label class="form-label mb-0 small text-muted">Year</label>
    <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" style="width:110px">
      <% available_years.forEach(function (y) { %>
        <option value="<%= y %>" <%= y === selected_year ? 'selected' : '' %>><%= y %></option>
      <% }) %>
      <% if (!available_years.includes(selected_year)) { %>
        <option value="<%= selected_year %>" selected><%= selected_year %> (no data)</option>
      <% } %>
    </select>
  </form>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-3"><div class="stat-tile"><div class="label">Total Approved Spend</div><div class="value">$<%= fmtMoney(total_spend) %></div></div></div>
  <div class="col-md-3"><div class="stat-tile accent-recurring"><div class="label">Recurring Spend</div><div class="value">$<%= fmtMoney(recurring_total) %></div></div></div>
  <div class="col-md-3"><div class="stat-tile accent-onetime"><div class="label">One-Time Spend</div><div class="value">$<%= fmtMoney(onetime_total) %></div></div></div>
  <div class="col-md-3"><div class="stat-tile accent-event"><div class="label">Event/Marketing</div><div class="value">$<%= fmtMoney(event_marketing_total) %></div></div></div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-6"><div class="stat-tile"><div class="label">Pending Approvals</div><div class="value"><%= pending_count %></div>
    <% if (pending_count) { %><a href="/admin/transactions/requests" class="small">Review &rarr;</a><% } %>
  </div></div>
  <div class="col-md-6"><div class="stat-tile"><div class="label">Potential Upcoming</div><div class="value">$<%= fmtMoney(upcoming_spend) %></div></div></div>
</div>

<% if (spend_by_tag && spend_by_tag.size) { %>
<div class="card p-3 mb-4">
  <h6>Spend by Category &amp; Tag</h6>
  <p class="text-muted small mb-2">The 4 main categories, broken down by tag -- what's actually driving spend within each.</p>
  <div class="row g-3">
    <% spend_by_tag.forEach(function (tagRows, categoryName) { %>
      <div class="col-md-6">
        <div class="small text-muted text-uppercase mb-1" style="letter-spacing:.03em;"><%= categoryName %></div>
        <table class="table table-sm mb-3">
          <tbody>
            <% tagRows.forEach(function (pair) { %>
            <tr><td><%= pair[0] %></td><td class="text-end">$<%= fmtMoney(pair[1]) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<% if (by_employee && by_employee.length) { %>
<div class="card p-3 mb-4">
  <h6>Spend by Person</h6>
  <p class="text-muted small mb-2">Who submitted/is attributed to each transaction -- "Bulk Import" covers rows from a spreadsheet import with no employee mapped. See <a href="/admin/employees/roi">Employee ROI</a> for invested-vs-returned detail.</p>
  <table class="table table-sm mb-0">
    <thead><tr><th>Person</th><th class="text-end">Total Spend</th></tr></thead>
    <tbody>
      <% by_employee.forEach(function (pair) { %>
      <tr><td><%= pair[0] %></td><td class="text-end">$<%= fmtMoney(pair[1]) %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<div class="row g-3 chart-row mb-4">
  <div class="col-md-6">
    <div class="card p-3">
      <h6>Spend by Category</h6>
      <% if (hasCategories) { %><canvas id="catChart" height="220"></canvas>
      <% } else { %><div class="empty-chart-state">No spend recorded for this period yet</div><% } %>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card p-3">
      <h6>Recurring / One-Time / Event-Marketing</h6>
      <% if (hasSplit) { %><canvas id="splitChart" height="220"></canvas>
      <% } else { %><div class="empty-chart-state">No spend recorded for this period yet</div><% } %>
      <% if (recurring_by_basis && recurring_by_basis.length) { %>
        <hr>
        <div class="small text-muted text-uppercase mb-2" style="letter-spacing:.03em;">Recurring Spend by Frequency</div>
        <table class="table table-sm mb-0">
          <tbody>
            <% recurring_by_basis.forEach(function (pair) { %>
            <tr><td><%= pair[0] %></td><td class="text-end">$<%= fmtMoney(pair[1]) %></td></tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  </div>
</div>

<div class="row g-3 chart-row mb-4">
  <div class="col-md-12">
    <div class="card p-3">
      <h6>Monthly Trend</h6>
      <% if (hasMonths) { %><canvas id="monthChart" height="120"></canvas>
      <% } else { %><div class="empty-chart-state">No spend recorded for this period yet</div><% } %>
    </div>
  </div>
</div>

<% if (spend_by_kind && spend_by_kind.length) { %>
<div class="card p-3">
  <h6>Spend by Type — Fixed vs. Discretionary</h6>
  <p class="text-muted small mb-2">How much of spend is committed/predictable vs. controllable, based on each category's assigned type (Settings &rarr; Categories).</p>
  <table class="table table-sm mb-0">
    <thead><tr><th>Type</th><th class="text-end">Total Spend</th><th class="text-end">% of Total</th></tr></thead>
    <tbody>
      <% spend_by_kind.forEach(function (pair) { %>
      <tr><td><%= pair[0] %></td><td class="text-end">$<%= fmtMoney(pair[1]) %></td><td class="text-end"><%= total_spend ? (pair[1] / total_spend * 100).toFixed(1) : '0.0' %>%</td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>

<p class="text-muted small mt-3">Top Vendors and Year-over-Year detail moved to the <a href="/admin/reports">Reports</a> page.</p>

<%- include('partials/foot', { extraScripts }) %>
