<%- include('partials/head', { title: 'Submit Expense' }) %>
<h3 class="mb-3">Submit an Expense Report</h3>

<div class="card p-4 mb-4">
  <h6 class="text-muted">Step 1 (optional): attach a receipt to auto-fill the form</h6>
  <form method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
    <div class="col-md-8">
      <input type="file" name="receipt" class="form-control" accept=".png,.jpg,.jpeg,.pdf">
    </div>
    <div class="col-md-4">
      <button type="submit" name="extract_only" value="1" class="btn btn-outline-primary w-100">Scan Receipt</button>
    </div>
  </form>
  <p class="small text-muted mt-2 mb-0">We'll try to read the date, amount, vendor, and category off the receipt — always double-check before submitting, extraction isn't perfect.</p>
</div>

<div class="card p-4">
  <h6 class="text-muted mb-3">Step 2: review and submit</h6>
  <form method="post">
    <input type="hidden" name="receipt_path" value="<%= extracted ? (extracted.receipt_path || '') : '' %>">
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Date *</label>
        <input type="date" name="date" class="form-control" required
               value="<%= extracted && extracted.date ? extracted.date : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Amount ($) *</label>
        <input type="number" step="0.01" name="amount" class="form-control" required
               value="<%= extracted && extracted.amount ? extracted.amount : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Category *</label>
        <select name="category_id" id="category_id" class="form-select" required>
          <option value="">Choose...</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= extracted && extracted.suggested_category === c.name ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Link (optional)</label>
      <input type="url" name="link" class="form-control" placeholder="https://...">
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Vendor / Merchant</label>
        <input type="text" name="vendor_name" class="form-control" list="vendor-list"
               value="<%= extracted && extracted.vendor ? extracted.vendor : '' %>">
        <datalist id="vendor-list">
          <% vendors.forEach(function (v) { %><option value="<%= v.name %>"><% }) %>
        </datalist>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Description</label>
        <input type="text" name="description" class="form-control"
               value="<%= extracted ? (extracted.description || '') : '' %>">
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Notes — what was this for?</label>
      <textarea name="notes" class="form-control" rows="2" placeholder="e.g. client dinner with ABC Corp, team offsite supplies, etc."></textarea>
    </div>
    <div class="form-check mb-3">
      <input type="checkbox" class="form-check-input" name="is_one_time" id="one_time" <%= extracted && extracted.suggest_one_time ? 'checked' : '' %>>
      <label class="form-check-label" for="one_time">This is a one-time purchase (not expected to recur)</label>
    </div>
    <% if (extracted) { %>
      <div class="alert alert-secondary small">
        <strong>Extracted text (for your reference):</strong>
        <pre class="mb-0" style="white-space:pre-wrap;"><%= extracted.raw_text %></pre>
      </div>
    <% } %>
    <button type="submit" class="btn btn-primary">Submit for Approval</button>
  </form>
</div>
<%
const extraScripts = `
<script>
(function () {
  var categorySelect = document.getElementById('category_id');
  var oneTimeCheckbox = document.getElementById('one_time');
  categorySelect.addEventListener('change', function () {
    var text = categorySelect.options[categorySelect.selectedIndex].text;
    if (text === 'Events') oneTimeCheckbox.checked = true;
  });
})();
</script>
`;
%>
<%- include('partials/foot', { extraScripts }) %>
