<%- include('partials/head', { title: 'Submit Expense' }) %>
<h3 class="mb-3">Submit an Expense Report</h3>

<div class="card p-4 mb-4">
  <h6 class="text-muted">
    Step 1 (optional): attach a receipt to auto-fill the form
    <% if (ai_enabled) { %><span class="badge bg-primary ms-1">AI-Powered</span><% } %>
  </h6>
  <form method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
    <div class="col-md-8">
      <input type="file" name="receipt" class="form-control" accept=".png,.jpg,.jpeg,.pdf">
    </div>
    <div class="col-md-4">
      <button type="submit" name="extract_only" value="1" class="btn btn-outline-primary w-100">Scan Receipt</button>
    </div>
  </form>
  <% if (ai_enabled) { %>
    <p class="small text-muted mt-2 mb-0">A local AI model reads the whole receipt image — vendor, date, amount, and category (even suggesting a brand-new category when nothing existing fits). Nothing is saved yet: Step 2 below always requires your review before anything is submitted.</p>
  <% } else { %>
    <p class="small text-muted mt-2 mb-0">We'll try to read the date, amount, vendor, and category off the receipt — always double-check before submitting, extraction isn't perfect.</p>
  <% } %>
</div>

  <% if (extracted && extracted.duplicate_of && extracted.duplicate_of.length) { %>
    <div class="alert alert-danger mt-3 mb-0">
      Possible duplicate — an existing transaction on <%= extracted.date %> already has the same item text (#<%= extracted.duplicate_of.map(function(d){return d.id;}).join(', #') %>). Double-check this isn't the same receipt submitted twice before continuing.
    </div>
  <% } %>
</div>

<div class="card p-4">
  <h6 class="text-muted mb-3">Step 2: review and submit</h6>
  <form method="post" data-tag-scope>
    <input type="hidden" name="receipt_path" value="<%= extracted ? (extracted.receipt_path || '') : '' %>">
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Date *</label>
        <input type="date" name="date" class="form-control" required
               value="<%= extracted && extracted.date ? extracted.date : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Amount ($) *</label>
        <input type="number" step="0.01" name="amount" class="form-control" required
               value="<%= extracted && extracted.amount ? extracted.amount : '' %>">
      </div>
      <div class="col-md-4 mb-3">
        <label class="form-label">Category *</label>
        <select name="category_id" id="category_id" class="form-select" required data-tag-category-select>
          <option value="">Choose...</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= extracted && extracted.suggested_category === c.name ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
        <% if (extracted && extracted.suggested_event_type) { %>
          <div class="small text-muted mt-1">
            AI flags this as <strong><%= extracted.suggested_event_type %></strong>-type spend.
            <a target="_blank" href="/marketing/new?prefill_name=<%= encodeURIComponent(extracted.vendor || extracted.description || '') %>&prefill_type=<%= encodeURIComponent(extracted.suggested_event_type) %>&prefill_cost=<%= encodeURIComponent(extracted.amount || '') %>&prefill_date=<%= encodeURIComponent(extracted.date || '') %>">Log it in Marketing &amp; ROI &rarr;</a>
          </div>
        <% } %>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Tags <span class="text-muted small">(optional, pick any that fit)</span></label>
      <div class="d-flex flex-wrap gap-3">
        <% tags.forEach(function (t) { %>
          <div class="form-check" data-tag-category="<%= t.category_id %>">
            <input type="checkbox" class="form-check-input" name="tag" value="<%= t.name %>" id="tag-<%= t.id %>"
              <%= extracted && extracted.tags && extracted.tags.some(function (et) { return et.name === t.name; }) ? 'checked' : '' %>>
            <label class="form-check-label small" for="tag-<%= t.id %>"><%= t.name %></label>
          </div>
        <% }) %>
        <% if (extracted && extracted.tags) { %>
          <% const suggestedCat = categories.find(function (c) { return c.name === extracted.suggested_category; }); %>
          <% extracted.tags.filter(function (et) { return et.is_new; }).forEach(function (et) { %>
            <div class="form-check" data-tag-category="<%= suggestedCat ? suggestedCat.id : '' %>">
              <input type="checkbox" class="form-check-input" name="tag" value="<%= et.name %>" checked id="newtag-<%= et.name %>">
              <label class="form-check-label small" for="newtag-<%= et.name %>"><%= et.name %> <span class="badge bg-primary">new</span></label>
            </div>
          <% }) %>
        <% } %>
        <span class="small text-muted d-none" data-tag-empty></span>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4 mb-3">
        <label class="form-label">Quantity<%= required_fields.includes('quantity') ? ' *' : ' (optional)' %></label>
        <input type="number" step="any" name="quantity" class="form-control" <%= required_fields.includes('quantity') ? 'required' : '' %>
               value="<%= extracted && extracted.quantity ? extracted.quantity : '' %>">
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Link (optional)</label>
      <input type="url" name="link" class="form-control" placeholder="https://...">
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Vendor / Merchant<%= required_fields.includes('vendor') ? ' *' : '' %></label>
        <input type="text" name="vendor_name" class="form-control" list="vendor-list" <%= required_fields.includes('vendor') ? 'required' : '' %>
               value="<%= extracted && extracted.vendor ? extracted.vendor : '' %>">
        <datalist id="vendor-list">
          <% vendors.forEach(function (v) { %><option value="<%= v.name %>"><% }) %>
        </datalist>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label">Description</label>
        <input type="text" name="description" class="form-control"
               value="<%= extracted ? (extracted.description || '') : '' %>">
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Notes — what was this for?<%= required_fields.includes('notes') ? ' *' : '' %></label>
      <textarea name="notes" class="form-control" rows="2" placeholder="e.g. client dinner with ABC Corp, team offsite supplies, etc." <%= required_fields.includes('notes') ? 'required' : '' %>></textarea>
    </div>
    <% if (required_fields.includes('receipt')) { %>
      <p class="small text-muted">A scanned receipt is required — use Step 1 above to attach and scan one first.</p>
    <% } %>
    <div class="form-check mb-3">
      <input type="checkbox" class="form-check-input" name="is_one_time" id="one_time" <%= extracted && extracted.suggest_one_time ? 'checked' : '' %>>
      <label class="form-check-label" for="one_time">This is a one-time purchase (not expected to recur)</label>
    </div>
    <% if (extracted) { %>
      <div class="alert alert-secondary small">
        <strong>Extracted text (for your reference):</strong>
        <pre class="mb-0" style="white-space:pre-wrap;"><%= extracted.raw_text %></pre>
      </div>
    <% } %>
    <button type="submit" class="btn btn-primary">Submit for Approval</button>
  </form>
</div>
<%
const extraScripts = `
<script>
(function () {
  var oneTimeCheckbox = document.getElementById('one_time');
  var eventTagValues = ['Events', 'Conferences', 'Sponsorships'];
  document.querySelectorAll('input[name="tag"]').forEach(function (box) {
    if (eventTagValues.indexOf(box.value) === -1) return;
    box.addEventListener('change', function () {
      if (box.checked) oneTimeCheckbox.checked = true;
    });
  });
})();
</script>
`;
%>
<%- include('partials/foot', { extraScripts }) %>
