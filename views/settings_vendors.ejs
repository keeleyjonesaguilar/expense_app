<%- include('partials/head', { title: 'Settings — Vendors' }) %>
<h3 class="mb-3">Settings</h3>
<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link" href="/admin/settings">General</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/settings/users">Users</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/settings/categories">Categories</a></li>
  <li class="nav-item"><a class="nav-link active" href="/admin/settings/vendors">Vendors</a></li>
</ul>

<div class="card p-3 mb-4">
  <h6>Add Vendor</h6>
  <form method="post" action="/admin/settings/vendors" class="row g-2 align-items-end">
    <div class="col-md-4"><label class="form-label small mb-0">Name</label><input type="text" name="name" class="form-control form-control-sm" required></div>
    <div class="col-md-6"><label class="form-label small mb-0">Notes</label><input type="text" name="notes" class="form-control form-control-sm"></div>
    <div class="col-md-2"><button class="btn btn-primary btn-sm w-100">Add</button></div>
  </form>
</div>

<div class="card">
<table class="table table-sm mb-0">
  <thead class="table-light"><tr><th>Name</th><th>Notes</th><th></th></tr></thead>
  <tbody>
    <% vendors.forEach(function (v) { %>
    <tr>
      <form method="post" action="/admin/settings/vendors/<%= v.id %>/update" id="vf<%= v.id %>"></form>
      <td><input type="text" name="name" form="vf<%= v.id %>" value="<%= v.name %>" class="form-control form-control-sm" style="width:200px"></td>
      <td><input type="text" name="notes" form="vf<%= v.id %>" value="<%= v.notes || '' %>" class="form-control form-control-sm" style="width:300px"></td>
      <td><button class="btn btn-outline-secondary btn-sm" form="vf<%= v.id %>">Save</button></td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<%- include('partials/foot') %>
