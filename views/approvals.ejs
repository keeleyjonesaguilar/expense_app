<%- include('partials/head', { title: 'Approvals' }) %>
<h3 class="mb-3">Pending Approvals (<%= pending.length %>)</h3>
<% if (pending.length === 0) { %>
<p class="text-muted">Nothing pending — all caught up.</p>
<% } %>
<% pending.forEach(function (t) { %>
<div class="card p-3 mb-3">
  <div class="row">
    <div class="col-md-9">
      <div class="d-flex gap-3">
        <div><strong><%= fmtDate(t.date) %></strong></div>
        <div>$<%= fmt2(t.amount) %></div>
        <div class="text-muted"><%= t.category ? t.category.name : 'Uncategorized' %></div>
        <% if (t.is_one_time) { %><span class="badge badge-onetime">One-Time</span><% } %>
      </div>
      <div>Submitted by <strong><%= t.submitted_by ? t.submitted_by.name : '' %></strong> — <%= t.description %></div>
      <% if (t.vendor) { %><div class="text-muted small">Vendor: <%= t.vendor.name %></div><% } %>
      <% if (t.notes) { %><div class="small mt-1"><em>Notes: <%= t.notes %></em></div><% } %>
      <% if (t.receipt_path) { %><div class="mt-2"><a href="/data/receipts/<%= t.receipt_path.split('/').slice(1).join('/') %>" target="_blank">View receipt</a></div><% } %>
    </div>
    <div class="col-md-3 text-end">
      <form method="post" action="/admin/approvals/<%= t.id %>/approve" class="d-inline">
        <button class="btn btn-success btn-sm mb-2">Approve</button>
      </form>
      <button class="btn btn-outline-danger btn-sm mb-2" data-bs-toggle="collapse" data-bs-target="#reject-<%= t.id %>">Reject</button>
      <div class="collapse" id="reject-<%= t.id %>">
        <form method="post" action="/admin/approvals/<%= t.id %>/reject">
          <textarea name="reason" class="form-control form-control-sm mb-2" placeholder="Reason for rejection" rows="2"></textarea>
          <button class="btn btn-danger btn-sm w-100">Confirm Reject</button>
        </form>
      </div>
    </div>
  </div>
</div>
<% }) %>
<%- include('partials/foot') %>
