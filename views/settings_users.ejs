<%- include('partials/head', { title: 'Settings — Users' }) %>
<%- include('partials/settings_nav', { active: 'users' }) %>

<div class="card p-3 mb-4">
  <h6>Add User</h6>
  <form method="post" action="/admin/settings/users" class="row g-2 align-items-end">
    <div class="col-md-3"><label class="form-label small mb-0">Name</label><input type="text" name="name" class="form-control form-control-sm" required></div>
    <div class="col-md-3"><label class="form-label small mb-0">Email</label><input type="email" name="email" class="form-control form-control-sm" required></div>
    <div class="col-md-2"><label class="form-label small mb-0">Department</label><input type="text" name="department" class="form-control form-control-sm"></div>
    <div class="col-md-2">
      <label class="form-label small mb-0">Role</label>
      <select name="role" class="form-select form-select-sm">
        <option value="employee">Employee</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <div class="col-md-2"><label class="form-label small mb-0">Password</label><input type="password" name="password" minlength="6" class="form-control form-control-sm" required></div>
    <div class="col-12"><button class="btn btn-primary btn-sm">Add User</button></div>
  </form>
</div>

<div class="card">
<table class="table table-sm mb-0">
  <thead class="table-light"><tr><th>Name</th><th>Email</th><th>Department</th><th>Role</th><th>Status</th><th></th><th></th></tr></thead>
  <tbody>
    <% users.forEach(function (u) { %>
    <tr class="<%= u.active ? '' : 'text-muted' %>">
      <form method="post" action="/admin/settings/users/<%= u.id %>/update" id="uf<%= u.id %>"></form>
      <td><%= u.name %></td>
      <td><%= u.email %></td>
      <td><input type="text" name="department" form="uf<%= u.id %>" value="<%= u.department || '' %>" class="form-control form-control-sm" style="width:140px"></td>
      <td>
        <select name="role" form="uf<%= u.id %>" class="form-select form-select-sm" style="width:120px">
          <option value="employee" <%= u.role === 'employee' ? 'selected' : '' %>>Employee</option>
          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
        </select>
      </td>
      <td><% if (u.active) { %><span class="badge bg-success">Active</span><% } else { %><span class="badge bg-secondary">Deactivated</span><% } %></td>
      <td><button class="btn btn-outline-secondary btn-sm" form="uf<%= u.id %>">Save</button></td>
      <td class="text-end">
        <% if (u.active) { %>
          <button type="button" class="btn btn-outline-warning btn-sm" onclick="openConfirmModal({action:'/admin/settings/users/<%= u.id %>/deactivate', title:'Deactivate User', body:'<%= u.name %> will no longer be able to log in. This can be undone.', word:'deactivate', submitLabel:'Deactivate', submitClass:'btn-warning'})">Deactivate</button>
        <% } else { %>
          <form method="post" action="/admin/settings/users/<%= u.id %>/reactivate" class="d-inline"><button class="btn btn-outline-success btn-sm">Reactivate</button></form>
        <% } %>
        <button type="button" class="btn btn-outline-danger btn-sm" onclick="openConfirmModal({action:'/admin/settings/users/<%= u.id %>/delete', title:'Delete User', body:'Permanently delete the login for <%= u.name %>. Blocked if they have any submissions, approvals, or logged activity on record -- deactivate instead in that case.', word:'delete', submitLabel:'Delete User'})">Delete</button>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
</div>
<p class="text-muted small mt-2">Deleting a user is only allowed when they have no history on record (nothing submitted, approved, or logged) -- deactivate covers everyone else.</p>
<%- include('partials/foot') %>
