<%- include('partials/head', { title: 'Settings' }) %>
<h3 class="mb-3">Settings</h3>
<ul class="nav nav-tabs mb-4">
  <li class="nav-item"><a class="nav-link active" href="/admin/settings">General</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/settings/users">Users</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/settings/categories">Categories</a></li>
  <li class="nav-item"><a class="nav-link" href="/admin/settings/vendors">Vendors</a></li>
</ul>

<div class="card p-4" style="max-width:700px;">
  <form method="post">
    <div class="mb-3">
      <label class="form-label">Company Headcount</label>
      <input type="number" min="0" step="1" name="employee_count" class="form-control" style="max-width:200px" value="<%= headcount %>">
      <div class="form-text">Used for per-employee budget figures elsewhere in the app.</div>
    </div>
    <div class="mb-3">
      <label class="form-label">Request Supplies — intro text</label>
      <textarea name="request_form_intro" class="form-control" rows="2"><%= request_form_intro %></textarea>
      <div class="form-text">Shown at the top of the public <a href="/request-supplies" target="_blank">Request Supplies</a> form.</div>
    </div>
    <button class="btn btn-primary">Save</button>
  </form>
</div>

<div class="card p-4 mt-4 border-danger" style="max-width:700px;">
  <h6 class="text-danger">Danger Zone</h6>
  <p class="small text-muted mb-3">
    Permanently deletes every transaction (approved, pending, awaiting-order,
    and rejected -- manual entries, expense reports, bulk imports, and
    supply requests, all of it). Categories, vendors, and user accounts are
    left alone. <strong>This cannot be undone.</strong>
  </p>
  <form method="post" action="/admin/settings/reset-transactions" class="row g-2 align-items-end" id="reset-form">
    <div class="col-md-6">
      <label class="form-label small mb-0">Type <code>DELETE</code> to confirm</label>
      <input type="text" name="confirm" id="confirm-input" class="form-control" autocomplete="off">
    </div>
    <div class="col-md-6">
      <button type="submit" class="btn btn-danger w-100" id="reset-btn" disabled>Delete All Transactions</button>
    </div>
  </form>
</div>
<%
const extraScripts = `
<script>
(function () {
  var input = document.getElementById('confirm-input');
  var btn = document.getElementById('reset-btn');
  var form = document.getElementById('reset-form');
  input.addEventListener('input', function () { btn.disabled = input.value !== 'DELETE'; });
  form.addEventListener('submit', function (e) {
    if (!confirm('This permanently deletes every transaction. Are you sure?')) e.preventDefault();
  });
})();
</script>
`;
%>
<%- include('partials/foot', { extraScripts }) %>
