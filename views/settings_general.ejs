<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/settings_nav', { active: 'general' }) %>

<div class="card p-4" style="max-width:700px;">
  <form method="post">
    <div class="mb-3">
      <label class="form-label">Company Headcount</label>
      <input type="number" min="0" step="1" name="employee_count" class="form-control" style="max-width:200px" value="<%= headcount %>">
      <div class="form-text">Used for per-employee budget figures elsewhere in the app.</div>
    </div>
    <div class="mb-3">
      <label class="form-label">Request Supplies — intro text</label>
      <textarea name="request_form_intro" class="form-control" rows="2"><%= request_form_intro %></textarea>
      <div class="form-text">Shown at the top of the public <a href="/request-supplies" target="_blank">Request Supplies</a> form.</div>
    </div>
    <div class="mb-3">
      <label class="form-label">Dashboard default year</label>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="dashboard_year_default" id="ddef-current" value="current-year" <%= dashboard_year_default === 'current-year' ? 'checked' : '' %>>
        <label class="form-check-label" for="ddef-current">Current calendar year (if it has data)</label>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="radio" name="dashboard_year_default" id="ddef-recent" value="most-recent" <%= dashboard_year_default === 'most-recent' ? 'checked' : '' %>>
        <label class="form-check-label" for="ddef-recent">Most recent year with data</label>
      </div>
      <div class="form-text">Used when the current year has no transactions yet, or as the always-default if "most recent" is chosen.</div>
    </div>
    <button class="btn btn-primary">Save</button>
  </form>
</div>
<%- include('partials/foot') %>
