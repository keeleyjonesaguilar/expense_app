<%- include('partials/head', { title: 'Import Events' }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Import Marketing Events</h3>
  <a href="/marketing" class="btn btn-outline-secondary btn-sm">&larr; Back to Marketing &amp; ROI</a>
</div>

<div class="card p-4 mb-4">
  <p class="text-muted">Upload a spreadsheet (CSV or Excel) of past events -- date, event name, location, cost, and notes are auto-detected by column header. Nothing is saved until you review it below and click Commit.</p>
  <form method="post" action="/marketing/import" enctype="multipart/form-data" class="row g-2">
    <div class="col-md-8"><input type="file" name="file" class="form-control" accept=".csv,.xlsx,.xls" required></div>
    <div class="col-md-4"><button class="btn btn-primary w-100">Upload &amp; Extract</button></div>
  </form>
</div>

<% if (preview_rows) { %>
<form method="post" action="/marketing/import/<%= upload_id %>/commit">
  <div class="card p-3">
    <h6>Review before importing (<%= preview_rows.length %> events)</h6>
    <div style="overflow-x:auto">
    <table class="table table-sm">
      <thead><tr><th>Skip</th><th>Date</th><th>Event Name</th><th>Type</th><th>Location</th><th class="text-end">Cost</th><th>Notes</th></tr></thead>
      <tbody>
      <% preview_rows.forEach(function (row, i) { %>
        <tr>
          <td><input type="checkbox" name="skip_<%= i %>"></td>
          <td><input type="date" name="date_<%= i %>" value="<%= row.date || '' %>" class="form-control form-control-sm" style="width:150px"></td>
          <td><input type="text" name="name_<%= i %>" value="<%= row.name || '' %>" class="form-control form-control-sm" style="width:220px" required></td>
          <td>
            <select name="event_type_<%= i %>" class="form-select form-select-sm" style="width:130px">
              <% event_types.forEach(function (t) { %><option value="<%= t %>" <%= row.event_type === t ? 'selected' : '' %>><%= t %></option><% }) %>
            </select>
          </td>
          <td><input type="text" name="location_<%= i %>" value="<%= row.location || '' %>" class="form-control form-control-sm" style="width:150px"></td>
          <td><input type="number" step="0.01" name="cost_<%= i %>" value="<%= row.cost != null ? row.cost : '' %>" class="form-control form-control-sm" style="width:100px"></td>
          <td><input type="text" name="notes_<%= i %>" value="<%= row.notes || '' %>" class="form-control form-control-sm" style="width:260px"></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    </div>
    <button class="btn btn-success">Commit Selected Events</button>
  </div>
</form>
<% } %>
<%- include('partials/foot') %>
