<%- include('partials/head', { title: 'New Event' }) %>
<h3 class="mb-3">Log a Marketing / Networking Event</h3>
<div class="card p-4" style="max-width:700px;">
  <form method="post">
    <div class="mb-3"><label class="form-label">Event Name *</label><input type="text" name="name" class="form-control" value="<%= prefill_name %>" required></div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label">Type</label>
        <select name="event_type" class="form-select">
          <option value="networking" <%= !prefill_type || prefill_type === 'networking' ? 'selected' : '' %>>Networking</option>
          <option value="conference" <%= prefill_type === 'conference' ? 'selected' : '' %>>Conference</option>
          <option value="marketing" <%= prefill_type === 'marketing' ? 'selected' : '' %>>Marketing / Advertising</option>
          <option value="sponsorship" <%= prefill_type === 'sponsorship' ? 'selected' : '' %>>Sponsorship</option>
        </select>
      </div>
      <div class="col-md-6 mb-3"><label class="form-label">Date</label><input type="date" name="date" class="form-control" value="<%= prefill_date %>"></div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3"><label class="form-label">Total Cost ($)</label><input type="number" step="0.01" name="cost" class="form-control" value="<%= prefill_cost %>"></div>
      <div class="col-md-6 mb-3"><label class="form-label">Location</label><input type="text" name="location" class="form-control"></div>
    </div>
    <div class="mb-3"><label class="form-label">Notes</label><textarea name="notes" class="form-control" rows="2"></textarea></div>
    <div class="mb-3">
      <label class="form-label d-block">Attendees <span class="text-muted small">(who from the company -- counts toward their personal investment total)</span></label>
      <%- include('partials/employee_picker', { id: 'new-event-attendees', fieldName: 'attendee_id', employees: employees, selected_ids: attendee_ids }) %>
    </div>
    <button class="btn btn-primary">Create Event</button>
  </form>
</div>
<%- include('partials/foot') %>
