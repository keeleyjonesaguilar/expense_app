<%- include('partials/head', { title: 'Verification Code' }) %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card p-4 mt-4">
      <h4 class="mb-1">Enter your verification code</h4>
      <p class="text-muted small mb-3">Open your authenticator app (e.g. Microsoft Authenticator) and enter the current 6-digit code.</p>
      <form method="post" action="/login/verify">
        <div class="mb-3">
          <label class="form-label">Code</label>
          <input type="text" name="code" class="form-control form-control-lg text-center" style="letter-spacing:.3em" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" maxlength="6" required autofocus>
        </div>
        <button type="submit" class="btn btn-primary w-100">Verify</button>
      </form>
      <p class="mt-3 text-muted small mb-0"><a href="/login">&larr; Back to log in</a></p>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
