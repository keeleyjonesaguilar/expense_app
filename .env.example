# Copy this file to .env and fill in real values before running anywhere
# other than your own machine. Never commit the real .env file.

# A long random string used to sign the session cookie (equivalent to Flask's
# SECRET_KEY). Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=change-me-to-a-random-value

# The first admin account, created automatically on first startup if no
# admin exists yet. Change these before deploying anywhere reachable by
# other people -- the app logs a warning on startup if you don't.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Optional. Leave unset to use a local SQLite file at instance/app.db (fine
# for one person or a small team). This port is SQLite-only -- Postgres
# DATABASE_URLs are not supported (the Python version supported Postgres via
# SQLAlchemy; this port intentionally does not). A sqlite:/// URL is
# supported if you want to point at a specific file path.
# DATABASE_URL=sqlite:////var/data/app.db

# Optional. Where uploaded receipts/import files are stored. Point this at a
# persistent disk's mount path in production -- otherwise uploaded files are
# lost on every redeploy, since the app's own source directory gets wiped
# and re-cloned each time.
# DATA_DIR=/var/data

# Port the server listens on.
PORT=5051
